# BioAccess database connection settings
# Copy this file as config.env beside BioAccess.exe or in the project root.
# Do not store MYSQL_PASSWORD here for normal use; BioAccess will ask for it at startup.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mydatabase
MYSQL_USER=bioaccess_app
MYSQL_SSL_MODE=REQUIRED
ALLOW_SQLITE_FALLBACK=0
